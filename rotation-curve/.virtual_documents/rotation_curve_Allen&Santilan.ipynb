import numpy as np
import matplotlib.pyplot as plt


x = np.linspace(0,100,10000) # kpc units
y = np.linspace(0,100,10000)
z = np.linspace(0,100,10000)

R = np.sqrt(x**2 + y**2 + z**2) # kpc units

# Central mass
M1 = 606.
b1 = 0.3873

dphi_x1 =  M1*x/(x**2 + y**2 + z**2 +b1**2)**(3/2)
dphi_y1 =  M1*y/(x**2 + y**2 + z**2 +b1**2)**(3/2) 
dphi_z1 =  M1*z/(x**2 + y**2 + z**2 +b1**2)**(3/2) 
dphi1 = dphi_x1 + dphi_y1 + dphi_z1 # meters?

ac_1 = - dphi1*100
vel_c1 = np.sqrt(-R*ac_1)# km/s


# Disk component
M2 = 3690.
a2 = 5.3178
b2 = 0.25

dphi_x2 = M2*x / (x**2 + y**2 + (a2 + np.sqrt(z**2 + b2))**2)**(3/2)
dphi_y2 = M2*y / (x**2 + y**2 + (a2 + np.sqrt(z**2 + b2))**2)**(3/2)
dphi_z2 = M2*(a2*z*1/np.sqrt(z**2 + b2**2) + z) / (x**2 + y**2 + (a2 + np.sqrt(z**2 + b2))**2)**(3/2)
dphi2 = dphi_x2 + dphi_y2 + dphi_z2 # meters?

ac_2 = -dphi2*100
vel_c2 = np.sqrt(-R*ac_2) # km/s





plt.plot(R, vel_c1, color = "purple", label = "Central mass", linestyle = "dashed")
plt.plot(R, vel_c2, color = "blue", label = "Disk", linestyle = "dotted")
plt.xlabel("R (kpc)")
plt.ylabel("Circular velocity (km s$^{-1}$)")
plt.xlim(0,100)
plt.legend()
plt.show()



